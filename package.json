{
  "name": "react-hook-inview",
  "version": "4.6.0-2",
  "description": "React Hook for detecting when an element is in the viewport",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitmap/react-hook-inview.git"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "build": "rm -rf dist && tsc && tsc -p tsconfig.esm.json",
    "prepublishOnly": "npm run lint && npm run test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "react",
    "react hook",
    "react hooks",
    "hook",
    "hooks",
    "inview",
    "in viewport",
    "viewport",
    "intersection observer"
  ],
  "author": {
    "name": "Cabe Branson",
    "url": "https://cabe.dev"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": ">= 16.8.0",
    "react-dom": ">= 16.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^19.2.8",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.13.0",
    "jsdom": "^27.4.0",
    "jsdom-testing-mocks": "^1.16.0",
    "prettier": "^3.9.10",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.0.17"
  }
}
